# =============================================
# DreamForge - Git Ignore
# =============================================

# --- LARGE BINARIES (never track) ---
python_embeded/
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
*.onnx
*.gguf
*.zip

# --- Model directories (symlinked or downloaded) ---
models/
!models/configs/
backend/models/*
backend/models_backup/

# --- Managed local engines ---
engines/comfyui/

# --- Generated outputs ---
outputs/
backend/outputs/
*.png
!apps/desktop/public/branding/*.png
!apps/desktop/src-tauri/icons/*.png
!backend/html/logo.png
!backend/html/logo-icon.png
!backend/html/logo-wordmark.png
!backend/html/background.png
!backend/html/init_image.png


# --- Temp / cache ---
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.log
temp/
backend/temp/
.cache/
apps/desktop/dist/
apps/desktop/node_modules/
apps/desktop/src-tauri/target/
apps/desktop/tsconfig.tsbuildinfo

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
Thumbs.db
.DS_Store
desktop.ini

# --- macOS app bundle (local launcher, not part of distribution) ---
DreamForge.app/

# --- Environment ---
.env
.antigravityignore
venv/
.setup/
/dreamforge/
backend/.dreamforge_python_stack_ok
.dreamforge_setup_ok
.dreamforge_comfy_deps_ok

# --- Research clones ---
.research/
.codex_upstream/
.tmp-agency-agents/

# --- Local Cursor agency install (user-wide copy lives in ~/.cursor/) ---
.cursor/*
!.cursor/skills/
!.cursor/skills/README.md
!.cursor/skills/agency-manifest.json
!.cursor/skills/install.ps1
.cursor/skills/agency-*/

# --- Stray icon copies at repo root ---
/icon.ico
/icon.icns
