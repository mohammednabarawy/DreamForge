{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DreamForge",
  "version": "0.4.0-beta",
  "identifier": "com.dreamforge.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DreamForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../backend/*.py": "backend/",
      "../../../backend/*.txt": "backend/",
      "../../../backend/*.yaml": "backend/",
      "../../../backend/.dreamforge_comfy_pin": "backend/.dreamforge_comfy_pin",
      "../../../backend/assets": "backend/assets/",
      "../../../backend/chatbots": "backend/chatbots/",
      "../../../backend/dreamforge_prompt": "backend/dreamforge_prompt/",
      "../../../backend/help": "backend/help/",
      "../../../backend/hints": "backend/hints/",
      "../../../backend/html": "backend/html/",
      "../../../backend/language": "backend/language/",
      "../../../backend/modules": "backend/modules/",
      "../../../backend/pip": "backend/pip/",
      "../../../backend/prompt_expansion": "backend/prompt_expansion/",
      "../../../backend/random_prompt": "backend/random_prompt/",
      "../../../backend/settings": "backend/settings/",
      "../../../backend/superprompter": "backend/superprompter/",
      "../../../backend/tools": "backend/tools/",
      "../../../backend/wildcards": "backend/wildcards/",
      "../../../backend/wildcards_official": "backend/wildcards_official/",
      "../../../scripts/*.py": "scripts/",
      "../../../scripts/*.bat": "scripts/",
      "../../../scripts/*.sh": "scripts/",
      "../../../scripts/python310._pth.template": "scripts/python310._pth.template"
    }
  },
  "plugins": {}
}
